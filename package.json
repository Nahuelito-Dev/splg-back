  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node --files scripts/seed.ts",
    "auditoria:mapa": "ts-node --files scripts/auditoria-mapa.ts",
    "seed:demo": "ts-node --files scripts/seed-demo.ts",
    "cuentas:demo": "ts-node --files scripts/cuentas-demo.ts",
    "s3:diagnostico": "ts-node --files scripts/diagnostico-bucket.ts",
    "fotos:demo": "ts-node --files scripts/completar-fotos-demo.ts",
    "fotos:reales": "ts-node --files scripts/fotos-reales-demo.ts",
    "crear-superadmin": "node dist/cli/crear-superadmin.js",
    "crear-superadmin:dev": "ts-node --files src/cli/crear-superadmin.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:tz": "TZ=UTC jest src/order/order.service.stats.spec.ts src/common/utils/dias-argentina.spec.ts src/reports",
    "test:watch": "jest --watch",
    "test:cov": "jest --ci --coverage",
    "test:debug": "node --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config ./test/jest-e2e.json --testPathPatterns=integration/.*\\.e2e-spec\\.ts$",
    "test:integration:health": "jest --config ./test/jest-e2e.json --testPathPatterns=health\\.e2e-spec\\.ts$",
    "test:integration:concurrency": "jest --config ./test/jest-e2e.json --testPathPatterns=orders-stock-concurrency\\.e2e-spec\\.ts$",
    "test:integration:redlock": "jest --config ./test/jest-e2e.json --testPathPatterns=redlock\\.e2e-spec\\.ts$",
    "test:integration:idempotency": "jest --config ./test/jest-e2e.json --testPathPatterns=orders-idempotency\\.e2e-spec\\.ts$",
    "test:integration:vehicle": "jest --config ./test/jest-e2e.json --testPathPatterns=vehicle-assignment-concurrency\\.e2e-spec\\.ts$",
    "test:perf:orders": "ts-node test/performance/orders-load.ts",
    "postman:generar": "node scripts/postman/generar-coleccion.js",
    "postman:guardar-ejemplos": "node scripts/postman/guardar-ejemplos.js",
    "postman:probar": "node scripts/postman/probar.js",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run lint:check && jest --ci --coverage && nest build"
  },
