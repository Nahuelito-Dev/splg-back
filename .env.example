# Copiá este archivo a .env y completá con valores reales. Ninguno de los
# valores de acá es válido: son placeholders.

APP_NAME="Garrafitas"
STAGE=dev
PORT=3000

# --- BASE DE DATOS (Postgres + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splg_db
DB_USERNAME=postgres
DB_PASSWORD=

# Distribuidora de los clientes que todavía no mandan X-Distributor.
DEFAULT_DISTRIBUTOR_SLUG=jeny-gas

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HEALTH (GET /health) ---
# RSS máxima (en MB) antes de que el chequeo de memoria reporte "down".
# 300 es el de un proceso recién levantado; con tráfico real lo supera
# (H-53). Default 512 si no se setea.
HEALTH_MEMORY_RSS_THRESHOLD_MB=512

# --- FIREBASE (Admin SDK + cliente) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_APP_API_KEY=

# --- SWAGGER (Basic Auth de /docs) ---
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Push (FCM) ---
# Milisegundos que se espera a FCM antes de seguir sin el push (default 5000).
FCM_TIMEOUT_MS=5000

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- EMAIL (Resend) ---
RESEND_API_KEY=

# --- MERCADOPAGO (Checkout Pro) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=

# --- ARCHIVOS EN AMAZON S3 (flota, adjuntos de empresa, foto del reclamo) ---
# S3 es el único proveedor. AWS_S3_BUCKET y AWS_REGION son obligatorias: sin
# ellas la app no arranca. Runbook: docs/S3.md
AWS_S3_BUCKET=
AWS_REGION=
# Credenciales del usuario IAM (el VPS está FUERA de AWS); van las dos juntas o
# ninguna. Vacías sólo si el servidor corriera en EC2 con un rol IAM. Las lee la
# cadena por defecto del SDK (también AWS_SESSION_TOKEN si son temporales).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sólo para MinIO / S3 compatibles en desarrollo. Vacíos en AWS.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Segundos de vigencia de la URL firmada de descarga (default 300).
AWS_S3_SIGNED_URL_TTL_SECONDS=300

# MinIO local (docker compose up -d minio minio-init). Para usarlo:
#   AWS_S3_BUCKET=splg-dev  AWS_REGION=us-east-1
#   AWS_S3_ENDPOINT=http://localhost:9000  AWS_S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=<MINIO_ROOT_USER>  AWS_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
# Los valores por defecto del compose están en docker-compose.yaml.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_KMS_SECRET_KEY=   (clave de cifrado de dev; hay un default en el compose)
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
