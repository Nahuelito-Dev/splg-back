# Copiá este archivo a .env y completá con valores reales. Ninguno de los
# valores de acá es válido: son placeholders.

# La plataforma (dueña del sistema): un solo lugar para su nombre (modo soporte, D11).
PLATFORM_NAME="SPLG"
PLATFORM_LEGAL_NAME="SPLG"
PLATFORM_SUPPORT_EMAIL=soporte@example.com
STAGE=dev
PORT=3000

# --- BASE DE DATOS (Postgres + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splg_db
DB_USERNAME=postgres
DB_PASSWORD=

# Distribuidora de los clientes que todavía no mandan X-Distributor.
DEFAULT_DISTRIBUTOR_SLUG=demo

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HEALTH (GET /health) ---
# RSS máxima (en MB) antes de que el chequeo de memoria reporte "down".
# 300 es el de un proceso recién levantado; con tráfico real lo supera
# (H-53). Default 512 si no se setea.
HEALTH_MEMORY_RSS_THRESHOLD_MB=512

# --- FIREBASE (Admin SDK + cliente) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_APP_API_KEY=

# --- SWAGGER (Basic Auth de /docs) ---
# Sin credenciales, /docs sólo se sirve abierta con NODE_ENV=development o test.
NODE_ENV=development
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Push (FCM) ---
# Milisegundos que se espera a FCM antes de seguir sin el push (default 5000).
FCM_TIMEOUT_MS=5000

# --- ÚLTIMA UBICACIÓN DEL CHOFER ---
# Minutos máximos de antigüedad de la posición que ve el cliente en el pedido (default 10).
DRIVER_LOCATION_MAX_AGE_MIN=10

# --- RATE LIMIT ---
# Subidas de archivos (multipart) por sesión; cada imagen se recodifica en el back.
THROTTLE_UPLOAD_LIMIT=10
THROTTLE_UPLOAD_TTL_MS=60000

# --- EXPORTES ---
# Tope de filas por exporte CSV/Excel (default 50000); si se pasa, la API responde 400.
EXPORT_MAX_ROWS=50000

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- EMAIL (Resend) ---
RESEND_API_KEY=

# --- RUTAS POR CALLES (GET /routes/driving) ---
# Clave de Google Directions DEL SERVIDOR (restringila por IP; no es la de las
# apps). Si falta, o Google falla, el back usa OSRM.
GOOGLE_DIRECTIONS_API_KEY=
# Servidor OSRM propio. El público (router.project-osrm.org) sólo se usa con
# NODE_ENV=development o test; en producción sin Google ni OSRM propio la ruta
# responde 503.
OSRM_BASE_URL=
# Topes de consultas al proveedor cada 24 h (429 al pasarse). Configurar además
# en Google Cloud una cuota diaria de Directions y una alerta de presupuesto.
ROUTES_DAILY_LIMIT_PER_USER=100
ROUTES_DAILY_LIMIT_PER_DISTRIBUTOR=3000
# Distancia máxima (m) entre `from` y la última posición conocida del chofer.
ROUTES_FROM_MAX_DISTANCE_M=300

# --- MERCADOPAGO (Checkout Pro) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
# A dónde vuelve el comprador tras pagar. Vacío = enlaces profundos de la app:
# splg://pago/exito, splg://pago/pendiente, splg://pago/error
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=
# Conciliación con el reporte de liberaciones. Vacío = el real (usa MP_ACCESS_TOKEN).
# `fake` (nunca en producción) devuelve el CSV de MP_REPORTS_FAKE_CSV sin llamar a Mercado Pago.
MP_REPORTS_DRIVER=
MP_REPORTS_FAKE_CSV=

# --- ARCHIVOS EN AMAZON S3 (flota, adjuntos de empresa, foto del reclamo) ---
# S3 es el único proveedor. AWS_S3_BUCKET y AWS_REGION son obligatorias: sin
# ellas la app no arranca. Runbook: splg-docs/sistema/back/S3.md
AWS_S3_BUCKET=
AWS_REGION=
# Credenciales del usuario IAM (el VPS está FUERA de AWS); van las dos juntas o
# ninguna. Vacías sólo si el servidor corriera en EC2 con un rol IAM. Las lee la
# cadena por defecto del SDK (también AWS_SESSION_TOKEN si son temporales).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sólo para S3 compatibles (los e2e los fijan solos para su MinIO efímero). Vacíos en AWS.
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
# Segundos de vigencia de la URL firmada de descarga (default 300).
AWS_S3_SIGNED_URL_TTL_SECONDS=300

# --- ANTIVIRUS DE LOS ADJUNTOS DEL CHAT (ClamAV) ---
# PDF, Word, Excel y CSV del chat se escanean con `clamd` (INSTREAM por TCP) antes
# de poder bajarse; las fotos no (las re-codifica sharp). En el servidor, el
# servicio `clamav` de docker-compose.servidor.yaml (CLAMAV_HOST=clamav). Vacío =
# sin antivirus (desarrollo): los archivos quedan limpios al toque.
CLAMAV_HOST=
# Con NODE_ENV=production CLAMAV_HOST es obligatorio; para arrancar sin antivirus
# a propósito, CLAMAV_DISABLED=true (queda un aviso en el log).
CLAMAV_DISABLED=false
CLAMAV_PORT=3310
# Tope de un escaneo en milisegundos (default 30000).
CLAMAV_TIMEOUT_MS=30000

# Red de seguridad de Postgres (ms, enteros positivos; si no son válidos se usa el default y se avisa en el log).
# Sesión que queda `idle in transaction` antes de que Postgres la corte (default 60000).
DB_IDLE_IN_TX_TIMEOUT_MS=60000
# Espera máxima por un lock antes de cortar con 503 (default 30000).
DB_LOCK_TIMEOUT_MS=30000
# Duración máxima de una consulta (default 90000).
DB_STATEMENT_TIMEOUT_MS=90000

# Lector de documentos (módulo M6). Sin ANTHROPIC_API_KEY los datos se cargan a mano.
ANTHROPIC_API_KEY=
# Opcionales: modelo (por omisión claude-opus-5-5) y esfuerzo (low | medium | high; por omisión medium).
LECTOR_MODELO=
LECTOR_ESFUERZO=
