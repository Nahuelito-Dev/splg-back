# Copiá este archivo a .env y completá con valores reales. Ninguno de los
# valores de acá es válido: son placeholders.

APP_NAME="Garrafitas"
STAGE=dev
PORT=3000

# --- BASE DE DATOS (Postgres + PostGIS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=splg_db
DB_USERNAME=postgres
DB_PASSWORD=

# Distribuidora de los clientes que todavía no mandan X-Distributor.
DEFAULT_DISTRIBUTOR_SLUG=jeny-gas

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- HEALTH (GET /health) ---
# RSS máxima (en MB) antes de que el chequeo de memoria reporte "down".
# 300 es el de un proceso recién levantado; con tráfico real lo supera
# (H-53). Default 512 si no se setea.
HEALTH_MEMORY_RSS_THRESHOLD_MB=512

# --- FIREBASE (Admin SDK + cliente) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_APP_API_KEY=

# --- SWAGGER (Basic Auth de /docs) ---
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Push (FCM) ---
# Milisegundos que se espera a FCM antes de seguir sin el push (default 5000).
FCM_TIMEOUT_MS=5000

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# --- EMAIL (Resend) ---
RESEND_API_KEY=

# --- MERCADOPAGO (Checkout Pro) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=
MP_SUCCESS_URL=
MP_FAILURE_URL=
MP_PENDING_URL=

# --- ALMACENAMIENTO DE ARCHIVOS (flota, adjuntos de empresa, foto del reclamo) ---
# 'local' (default): guarda en disco, en STORAGE_LOCAL_PATH. No requiere el
# resto de las variables de esta sección.
# 's3': sube a un bucket de Amazon S3 (o a MinIO en desarrollo); ahí
# STORAGE_S3_BUCKET y STORAGE_S3_REGION son obligatorias. Runbook: docs/S3.md
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage-local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
# Credenciales: dejarlas VACÍAS en el VPS de AWS (usa el rol IAM de la
# instancia). Sólo se completan fuera de AWS o con un usuario IAM propio.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Sólo para MinIO / S3 compatibles. Vacíos en AWS.
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
# Segundos de vigencia de la URL firmada de descarga (default 300).
STORAGE_S3_SIGNED_URL_TTL_SECONDS=300

# MinIO local (docker compose up -d minio minio-init). Para usarlo:
#   STORAGE_DRIVER=s3  STORAGE_S3_BUCKET=splg-dev  STORAGE_S3_REGION=us-east-1
#   STORAGE_S3_ENDPOINT=http://localhost:9000  STORAGE_S3_FORCE_PATH_STYLE=true
#   STORAGE_S3_ACCESS_KEY_ID=<MINIO_ROOT_USER>  STORAGE_S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
# Los valores por defecto del compose están en docker-compose.yaml.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_KMS_SECRET_KEY=   (clave de cifrado de dev; hay un default en el compose)
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
